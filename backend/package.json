{
  "name": "backend",
  "version": "1.0.0",
  "description": "backend repository for crunch it application.",
  "main": "dist/server.js",
  "scripts": {
    "clean": "rm -rf dist && rm -rf node_modules",
    "build": "pnpm clean && pnpm check-types && tsup src/server.ts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.mjs",
    "check-types": "tsc --noEmit"
  },
  "type": "module",
  "keywords": [
    "compress",
    "compression",
    "convert",
    "jpeg to png",
    "png to jpeg",
    "svg to png"
  ],
  "author": "karannakra1@gmail.com",
  "license": "MIT",
  "packageManager": "pnpm@10.15.0",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.929.0",
    "@aws-sdk/lib-storage": "^3.934.0",
    "@aws-sdk/s3-request-presigner": "^3.929.0",
    "@aws-sdk/util-stream-node": "^3.374.0",
    "@fastify/autoload": "^6.3.1",
    "@fastify/cors": "^11.1.0",
    "@fastify/env": "^5.0.3",
    "@fastify/multipart": "^9.2.1",
    "@fastify/mysql": "^5.0.2",
    "@fastify/redis": "^7.1.0",
    "@fastify/websocket": "^11.2.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "bullmq": "^5.63.0",
    "fastify": "^5.5.0",
    "fastify-plugin": "^5.1.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@crunchit/types": "workspace:*",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@types/node": "^20.19.11",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.5"
  }
}
